<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CGASTOSFE</title>
    <link rel="stylesheet" href="~/css/estilo.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    
</head>
<body id="body-pd">
    <div class="d-flex">
        <div class="l-navbar" id="navbar">
            <nav class="c-nav">
                <div>
                    <div class="nav__brand">
                        <ion-icon name="menu-outline" class="nav__toggle" id="nav-toggle"></ion-icon>
                        <a class="nav__logo" asp-area="" asp-controller="Home" asp-action="Index">Control de Gastos</a>
                    </div>
                    <div class="nav__list">
                        <a class="nav__link active" asp-area="" asp-controller="Home" asp-action="Index">
                            <ion-icon name="home-outline" class="nav__icon"></ion-icon>
                            <span class="nav__name">Home</span>
                        </a>
                        <div class="nav__link collapsefe">
                            <ion-icon name="pricetags-outline" class="nav__icon"></ion-icon>
                            <span class="nav__name">Productos</span>

                            <ion-icon name="chevron-down-outline" class="collapse__link"></ion-icon>

                            <ul class="collapse__menu">
                                <li>
                                    <a class="collapse__sublink" asp-area="" asp-controller="Producto" asp-action="Index">Detalles</a>
                                </li>
                                <li>
                                    <a class="collapse__sublink" asp-area="" asp-controller="Producto" asp-action="Create">Ingresar</a>
                                </li>
                            </ul>
                        </div>

                        <div class="nav__link collapsefe">
                            <ion-icon name="people-outline" class="nav__icon"></ion-icon>
                            <span class="nav__name">Proveedores</span>

                            <ion-icon name="chevron-down-outline" class="collapse__link"></ion-icon>

                            <ul class="collapse__menu">
                                <li>
                                    <a class="collapse__sublink" asp-area="" asp-controller="Proveedor" asp-action="Index">Detalles</a>
                                </li>                             
                                <li>                              
                                    <a class="collapse__sublink" asp-area="" asp-controller="Proveedor" asp-action="Create">Ingresar</a>
                                </li>                             
                            </ul>
                        </div>

                        <div class="nav__link collapsefe">
                            <ion-icon name="list-circle-outline" class="nav__icon"></ion-icon>
                            <span class="nav__name">Inventario</span>

                            <ion-icon name="chevron-down-outline" class="collapse__link"></ion-icon>

                            <ul class="collapse__menu">
                                <li>
                                    <a class="collapse__sublink" asp-area="" asp-controller="Inventario" asp-action="Index">Detalles</a>
                                </li>
                                <li>
                                    <a class="collapse__sublink" asp-area="" asp-controller="Inventario" asp-action="Create">Ingresar</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle collapse__menu" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <ion-icon name="settings-outline"></ion-icon>
                            <span @* class="dropdown-text dropdown-item" *@> @Context.Session.GetString("UserName") </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-start nav__icon collapse__menu" aria-labelledby="userMenuButton">
                            <li>
                                <a class="dropdown-item collapse__menu" asp-area="" asp-controller="Home" asp-action="Index">
                                    <ion-icon name="home-outline" class="nav__icon"></ion-icon>
                                    <span class="dropdown-text">Home</span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Usuario" asp-action="Index">
                                    <ion-icon name="people-outline" class="nav__icon"></ion-icon>
                                    <span class="dropdown-text">Usuarios</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item nav__link" href="@Url.Action("Logout", "Home")">
                                    <ion-icon name="log-out-outline" class="nav__icon"></ion-icon>
                                    <span class="dropdown-text">Cerrar sesión</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>

        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Control de Gastos S.A.
        </div>
    </footer>

    <!-- ===== IONICONS ===== -->
    <script src="https://unpkg.com/ionicons@5.1.2/dist/ionicons.js" asp-append-version="true"></script>

    <!-- ===== MAIN JS ===== -->
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
