@model IEnumerable<CGASTOSFE.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>

    <a class="btn btn-primary" asp-action="Create">Ingresar producto</a>
</p>

<table class="table">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>ProveedorId</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>

                <td>@producto.Id</td>
                <td>@producto.Nombre</td>
                <td>@producto.ProveedorId</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details"  asp-route-id="@producto.Id">Detalles</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit"  asp-route-id="@producto.Id">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@producto.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
