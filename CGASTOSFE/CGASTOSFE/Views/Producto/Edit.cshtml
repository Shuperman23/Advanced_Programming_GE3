@model CGASTOSFE.DTOs.ProductoDto
@{
    ViewData["Title"] = "Editar Producto";
}

<h1>Editar Producto</h1>

<form asp-action="Edit">
    
    <input type="hidden" asp-for="Id" />

    
    <div class="form-group">
        <label asp-for="Id" class="control-label"></label>
        <input asp-for="Id" class="form-control" />

        <span asp-validation-for="Id" class="text-danger"></span>
    </div>

    
    <div class="form-group">
        <label asp-for="Nombre" class="control-label"></label>
        <input asp-for="Nombre" class="form-control" />
        
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    
    <div class="form-group">
        <label asp-for="ProveedorId" class="control-label"></label>
        <input asp-for="ProveedorId" class="form-control" />
        
        <span asp-validation-for="ProveedorId" class="text-danger"></span>
    </div>

    <div class="form-group" style="padding-top: 20px;">
        <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
        <a class="btn btn-secondary ml-6" style="margin-left: 20px;" asp-action="Index">Volver</a>
    </div>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}