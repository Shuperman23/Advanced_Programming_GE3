@model CGASTOSFE.DTOs.UsuarioDTO

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<h1>Eliminar Usuario</h1>

<h3>¿Estás seguro de que quieres eliminar este usuario?</h3>

<div>
    
    <h4>@Model.Nombre</h4>
    
    <dl class="row">
        <dt class="col-sm-2">IdUsuario</dt>
        <dd class="col-sm-10">@Model.IdUsuario</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.Correo</dd>
        <dt class="col-sm-2">Pass</dt>
        <dd class="col-sm-10">@Model.Clave</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        
        <input type="hidden" name="id" value="@Model.IdUsuario"/>
        
        <div class="form-group" style="padding-top: 20px;">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a class="btn btn-secondary ml-6" style="margin-left: 20px;" asp-action="Index">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
