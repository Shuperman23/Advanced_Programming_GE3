@model CGASTOSFE.DTOs.InventarioDto


@{
    ViewData["Title"] = "Eliminar Producto de Inventario";
}

<h1>Eliminar Producto de Inventario</h1>

<h3>¿Estás seguro de que quieres eliminar este producto del inventario?</h3>

<div>
    
    <h4>@Model.ProductoId</h4>
    
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">ProductoId</dt>
        <dd class="col-sm-10">@Model.ProductoId</dd>
        <dt class="col-sm-2">TipoMovimiento</dt>
        <dd class="col-sm-10">@Model.TipoMovimiento</dd>
        <dt class="col-sm-2">Cantidad</dt>
        <dd class="col-sm-10">@Model.Cantidad</dd>
        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Precio</dd>
        <dt class="col-sm-2">FechaMovimiento</dt>
        <dd class="col-sm-10">@Model.FechaMovimiento</dd>
        <dt class="col-sm-2">FechaCaducidad</dt>
        <dd class="col-sm-10">@Model.FechaCaducidad</dd>

    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        
        <input type="hidden" name="id" value="@Model.Id" />


        <div class="form-group" style="padding-top: 20px;">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a class="btn btn-secondary ml-6" style="margin-left: 20px;" asp-action="Index">Volver</a>
        </div>

    </form>
 </div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}