@model CGASTOSFE.DTOs.ProveedorDto
@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<h1>Detalles del Proveedor</h1>

<div>
    
    <h4>@Model.Nombre</h4>

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
        <dt class="col-sm-2">Direccion</dt>
        <dd class="col-sm-10">@Model.Direccion</dd>
        <dt class="col-sm-2">Telefono</dt>
        <dd class="col-sm-10">@Model.TelefonoContacto</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.TelefonoContacto</dd>
    </dl>

    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}