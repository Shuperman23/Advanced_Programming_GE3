@model CGASTOSFE.DTOs.ProveedorDto
@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<h1>Eliminar Proveedor</h1>

<h3>¿Estás seguro de que quieres eliminar este proveedor?</h3>

<div>
    
    <h4>@Model.Nombre</h4>
    
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Id</dd>
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
        <dt class="col-sm-2">Direccion</dt>
        <dd class="col-sm-10">@Model.Direccion</dd>
        <dt class="col-sm-2">Telefono</dt>
        <dd class="col-sm-10">@Model.TelefonoContacto</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.EmailContacto</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group" style="padding-top: 20px;">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            <a class="btn btn-secondary ml-6" style="margin-left: 20px;" asp-action="Index">Volver</a>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}