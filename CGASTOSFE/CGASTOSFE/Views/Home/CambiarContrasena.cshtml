@model CGASTOSFE.DTOs.CambiarContrasenaDTO

@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="login-container">
        <img src="/Imagenes/logo.png" alt="Logo de Gestión de Gastos" />
        <div class="welcome-text">Cambiar Contraseña</div>
        <div class="login-box">
            <h2>Cambiar Contraseña</h2>
            <form asp-action="CambiarContrasena" method="post">
                <div class="textbox">
                    <input asp-for="Correo" type="email" readonly />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="textbox">
                    <input asp-for="NuevaClave" type="password" placeholder="Nueva Contraseña" required />
                    <span asp-validation-for="NuevaClave" class="text-danger"></span>
                </div>
                <button type="submit" class="btn">Cambiar Contraseña</button>
            </form>
        </div>
    </div>
    @* Mostrar mensajes de error generales *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
</body>
</html>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
